rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* ================= Helpers ================= */

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        );
    }

    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function userHasRole(roleName) {
      return hasUserDoc()
        && (
          (
            userDoc().data.keys().hasAny(["role"])
            && userDoc().data.role == roleName
          )
          ||
          (
            userDoc().data.keys().hasAny(["primaryRole"])
            && userDoc().data.primaryRole == roleName
          )
          ||
          (
            userDoc().data.keys().hasAny(["roles"])
            && userDoc().data.roles is list
            && roleName in userDoc().data.roles
          )
        );
    }

    function isRoot() {
      return userHasRole("root");
    }

    function userInmobiliarias() {
      return hasUserDoc()
        && userDoc().data.keys().hasAny(["inmobiliarias"])
        && userDoc().data.inmobiliarias is list
        ? userDoc().data.inmobiliarias
        : [];
    }

    function belongsToUserInmobiliaria(inmobiliariaId) {
      return isSignedIn()
        && inmobiliariaId in userInmobiliarias();
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isValidImageSize() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isValidInstagramReel() {
      return request.resource != null
        && request.resource.contentType.matches('^video/(mp4|quicktime)$')
        && request.resource.size <= 300 * 1024 * 1024;
    }
    
    function isValidParticularRequestImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isValidVerificationFile() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(application/pdf|image/jpeg|image/png)$'
        );
    }

    function isValidBillingProof() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(application/pdf|image/.*)$'
        );
    }

    function isAgencyAdmin(inmobiliariaId) {
      return isRoot()
        || (userHasRole("admin") && belongsToUserInmobiliaria(inmobiliariaId));
    }

    function hasVerifiedAuthEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function hasConsortiumPortalAccess(inmobiliariaId, consortiumId) {
      return hasVerifiedAuthEmail()
        && firestore.exists(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominiums/$(consortiumId)
        )
        && firestore.get(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominiums/$(consortiumId)
        ).data.portalEmails is list
        && request.auth.token.email in firestore.get(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominiums/$(consortiumId)
        ).data.portalEmails;
    }

    function hasConsortiumUnitPortalAccess(inmobiliariaId, unitId) {
      return hasVerifiedAuthEmail()
        && firestore.exists(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_units/$(unitId)
        )
        && firestore.get(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_units/$(unitId)
        ).data.portalEmails is list
        && request.auth.token.email in firestore.get(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_units/$(unitId)
        ).data.portalEmails;
    }

    function isValidConsortiumDocument() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(application/pdf|image/jpeg|image/png|image/webp)$'
        );
    }

    /* ================= Inmobiliarias - documentación privada ================= */

    match /inmobiliarias/{inmobiliariaId}/verificacion/{userId}/{fileName} {

      allow read: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);

      allow create, update: if
        isSignedIn()
        && request.auth.uid == userId
        && belongsToUserInmobiliaria(inmobiliariaId)
        && isValidVerificationFile();

      allow delete: if
        isRoot()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && belongsToUserInmobiliaria(inmobiliariaId)
        );
    }

    /* ================= Inmobiliarias - branding público ================= */

    match /inmobiliarias/{inmobiliariaId}/branding/{allPaths=**} {

      allow read: if true;

      allow create, update: if
        isSignedIn()
        && belongsToUserInmobiliaria(inmobiliariaId)
        && isImage()
        && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    match /inmobiliarias/{inmobiliariaId}/logo/{allPaths=**} {

      allow read: if true;

      allow create, update: if
        isSignedIn()
        && belongsToUserInmobiliaria(inmobiliariaId)
        && isImage()
        && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    match /inmobiliarias/{inmobiliariaId}/backgrounds/{allPaths=**} {

      allow read: if true;

      allow create, update: if
        isSignedIn()
        && belongsToUserInmobiliaria(inmobiliariaId)
        && isImage()
        && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    match /inmobiliarias/{inmobiliariaId}/{fileName} {

      allow read: if true;

      allow create, update: if
        isSignedIn()
        && belongsToUserInmobiliaria(inmobiliariaId)
        && isImage()
        && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    /* ================= Inmuebles ================= */

    match /inmuebles/{inmobiliariaId}/{inmuebleId}/{fileName} {

      allow read: if true;

      allow create, update: if
  isSignedIn()
  && (
    isRoot()
    || belongsToUserInmobiliaria(inmobiliariaId)
  )
  && isImage()
  && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    /* ================= Emprendimientos ================= */

    match /emprendimientos/{inmobiliariaId}/{emprendimientoId}/{fileName} {

      allow read: if true;

      allow create, update: if
        isSignedIn()
        && (
          isRoot()
          || belongsToUserInmobiliaria(inmobiliariaId)
        )
        && isImage()
        && isValidImageSize();

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    match /inmuebles/{inmobiliariaId}/{inmuebleId}/instagram/{fileName} {

      allow read: if true;

      allow create: if
        isSignedIn()
        && (
          isRoot()
          || belongsToUserInmobiliaria(inmobiliariaId)
        )
        && isValidInstagramReel();

      allow update: if false;

      allow delete: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);
    }

    /* ================= Solicitudes particulares - imágenes privadas =================
       Ruta:
       /particular_publication_requests/{requestId}/{userId}/{fileName}
    */

    match /particular_publication_requests/{requestId}/{userId}/{fileName} {
    
      allow get: if isSignedIn();

      allow list: if false;

      allow create: if
        isSignedIn()
        && request.auth.uid == userId
        && isValidParticularRequestImage();

     allow update: if false;

     allow delete: if
       isRoot()
       || (
         isSignedIn()
         && request.auth.uid == userId
        );
    }

    /* ================= Cuenta corriente - comprobantes privados ================= */

    match /billing/{inmobiliariaId}/payment-proofs/{reportId}/{fileName} {
      allow read: if
        isRoot()
        || belongsToUserInmobiliaria(inmobiliariaId);

      allow create: if
        (
          isRoot()
          || belongsToUserInmobiliaria(inmobiliariaId)
        )
        && isValidBillingProof();

      allow update: if false;

      allow delete: if
        isRoot()
        || (
          belongsToUserInmobiliaria(inmobiliariaId)
          && !firestore.exists(
            /databases/(default)/documents/billing_payment_reports/$(reportId)
          )
        );
    }

    /* ================= Consorcios - documentación privada ================= */

    match /consorcios/{inmobiliariaId}/{consortiumId}/expenses/{periodId}/{expenseId}/{documentId}/{fileName} {
      allow read: if
        isAgencyAdmin(inmobiliariaId)
        || hasConsortiumPortalAccess(inmobiliariaId, consortiumId);

      allow create: if
        isAgencyAdmin(inmobiliariaId)
        && isValidConsortiumDocument();

      allow update: if false;

      allow delete: if
        isAgencyAdmin(inmobiliariaId)
        && !firestore.exists(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_expense_documents/$(documentId)
        );
    }

    match /consorcios/{inmobiliariaId}/{consortiumId}/payment-reports/{unitId}/{reportId}/{userId}/{fileName} {
      allow read: if
        isAgencyAdmin(inmobiliariaId)
        || hasConsortiumUnitPortalAccess(inmobiliariaId, unitId);

      allow create: if
        isSignedIn()
        && request.auth.uid == userId
        && hasConsortiumUnitPortalAccess(inmobiliariaId, unitId)
        && isValidConsortiumDocument();

      allow update: if false;

      allow delete: if
        isSignedIn()
        && request.auth.uid == userId
        && hasConsortiumUnitPortalAccess(inmobiliariaId, unitId)
        && !firestore.exists(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_payment_reports/$(reportId)
        );
    }

    match /consorcios/{inmobiliariaId}/{consortiumId}/penalties/{unitId}/{penaltyId}/{fileName} {
      allow read: if
        isAgencyAdmin(inmobiliariaId)
        || (
          hasConsortiumUnitPortalAccess(inmobiliariaId, unitId)
          && firestore.exists(
            /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_penalties/$(penaltyId)
          )
          && firestore.get(
            /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_penalties/$(penaltyId)
          ).data.portalVisible == true
        );

      allow create: if
        isAgencyAdmin(inmobiliariaId)
        && isValidConsortiumDocument();

      allow update: if false;

      allow delete: if
        isAgencyAdmin(inmobiliariaId)
        && !firestore.exists(
          /databases/(default)/documents/inmobiliarias/$(inmobiliariaId)/condominium_penalties/$(penaltyId)
        );
    }

    /* ================= Fallback ================= */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
