{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:omi": "node --test omi.helpers.test.js",
    "test:arca": "node --test arca.helpers.test.js",
    "test:tax": "node --test tax.helpers.test.js",
    "test:parcelas": "node --test parcelas.helpers.test.js",
    "test:consorcios": "node --test consortium.helpers.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
